PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_fleet
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173

# Segurança
# Se for true, permite que o script seed.js limpe (TRUNCATE) o banco de dados. Nunca ative em produção!
ALLOW_SEED_WIPE=true
NODE_ENV=development

# Facial Verification
FACE_PROVIDER=mock # mock ou rekognition
FACE_MATCH_THRESHOLD=0.90
FACIAL_ATTEMPTS_RETENTION_DAYS=90
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Biometria Facial
# Use 'mock' em desenvolvimento para testes locais.
# Em producao, nao preencha (desativado) ou use o provedor real.
FACE_PROVIDER=mock

