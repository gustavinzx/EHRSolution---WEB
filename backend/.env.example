PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_fleet
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# CORS
# CORS_ORIGINS=http://localhost:5173,https://meu-app.com.br

# Autenticação Facial e Segurança
# Provedor facial: "rekognition" (AWS) ou "mock" (apenas para testes; falha em produção).
# Sem provedor configurado, a API retorna 503.
FACE_PROVIDER=mock
# Modo do mock facial: "marker" (padrão) ou "always_match" (somente desenvolvimento; nunca em produção).
FACE_MOCK_MODE=marker
FACE_MATCH_THRESHOLD=0.90
FACIAL_MAX_ATTEMPTS=3
FACIAL_ATTEMPTS_RETENTION_DAYS=90
GEOFENCE_KM=0.2

# Credenciais AWS Rekognition
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=sua_chave
# AWS_SECRET_ACCESS_KEY=seu_segredo

# Simulador de Telemetria
DATA_SOURCE=mock
SIMULATOR_ENABLED=true

# Hardware Virtual (somente desenvolvimento/demonstração; nunca em produção; desligar quando o hardware real for integrado)
VIRTUAL_HARDWARE_ENABLED=false

# Catálogo Nacional de Postos ANP (API Oficial de Revendedores ANP)
ANP_API_BASE=https://revendedoresapi.anp.gov.br/v1
# Raio em metros para casamento automático de abastecimentos com postos ANP (padrão 150; aceita de 30 a 1000)
STATION_MATCH_RADIUS_M=150
