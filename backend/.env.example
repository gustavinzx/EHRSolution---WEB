PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_fleet
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# CORS
# CORS_ORIGINS=http://localhost:5173,https://meu-app.com.br

# Autenticação Facial e Segurança
# Provedor facial: "rekognition" (AWS) ou "mock" (apenas para testes; falha em produção).
# Sem provedor configurado, a API retorna 503.
FACE_PROVIDER=mock
FACE_MATCH_THRESHOLD=0.90
FACIAL_MAX_ATTEMPTS=3
FACIAL_ATTEMPTS_RETENTION_DAYS=90
GEOFENCE_KM=0.2

# Credenciais AWS Rekognition
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=sua_chave
# AWS_SECRET_ACCESS_KEY=seu_segredo

# Simulador
DATA_SOURCE=mock
SIMULATOR_ENABLED=true
