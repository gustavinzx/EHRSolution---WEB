# ========== CONFIGURAÇÕES DO SERVIDOR ==========
PORT=3001
NODE_ENV=development

# ========== BANCO DE DADOS ==========
# As credenciais devem bater com o docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_fleet
DB_USER=postgres
DB_PASSWORD=postgres

# ========== AUTENTICAÇÃO ==========
# Em produção (NODE_ENV=production), JWT_SECRET DEVE ter ao menos 32 caracteres
# e não pode ser a senha padrão, senão o servidor não inicializa.
JWT_SECRET=super_secret_jwt_key_for_development
JWT_EXPIRES_IN=8h

# ========== RECONHECIMENTO FACIAL ==========
# Provedor da IA facial: "mock" (desenvolvimento) ou "aws"/"azure" (produção)
FACE_PROVIDER=mock
# Nota de corte para similaridade facial (0 a 1)
FACE_MATCH_THRESHOLD=0.85
# Quantos dias manter imagens de falhas faciais antes de expurgar
FACIAL_ATTEMPTS_RETENTION_DAYS=7

# ========== REGRAS DE NEGÓCIO ==========
# Raio máximo em KM para permitir abastecimento (Geofencing)
GEOFENCE_KM=0.2

# ========== SIMULADOR E AMBIENTE ==========
# Ativa o simulador de GPS e consumo dos caminhões (ideal para testes locais)
SIMULATOR_ENABLED=true
# Permite que o comando npm run seed limpe o banco antes de popular
ALLOW_SEED_WIPE=true
