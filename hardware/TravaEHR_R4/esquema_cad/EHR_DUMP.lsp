;;; EHR_DUMP - exporta entidades do desenho para EHR_DUMP.txt (mesma pasta do DWG)
(vl-load-com)
(defun ehr:pt (p) (if p (strcat (rtos (car p) 2 3) "," (rtos (cadr p) 2 3)) ""))
(defun ehr:bb (o / mn mx)
  (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list o 'mn 'mx))))
    (strcat (ehr:pt (vlax-safearray->list mn)) "|" (ehr:pt (vlax-safearray->list mx))) "?"))
(defun ehr:clean (s) (vl-string-translate "\t\n\r" "   " s))
(defun ehr:ent (f e pref / d ty o ln v)
  (setq d (entget e) ty (cdr (assoc 0 d)) o (vlax-ename->vla-object e))
  (setq ln (strcat pref (cdr (assoc 5 d)) "\t" ty "\t" (cdr (assoc 8 d)) "\t"
                   (if (assoc 62 d) (itoa (cdr (assoc 62 d))) "BL") "\t" (ehr:bb o) "\t"))
  (cond
    ((= ty "LINE") (setq ln (strcat ln (ehr:pt (cdr (assoc 10 d))) ";" (ehr:pt (cdr (assoc 11 d))))))
    ((= ty "CIRCLE") (setq ln (strcat ln (ehr:pt (cdr (assoc 10 d))) ";R=" (rtos (cdr (assoc 40 d)) 2 3))))
    ((= ty "ARC") (setq ln (strcat ln (ehr:pt (cdr (assoc 10 d))) ";R=" (rtos (cdr (assoc 40 d)) 2 3)
                    ";A=" (rtos (cdr (assoc 50 d)) 2 4) ";" (rtos (cdr (assoc 51 d)) 2 4))))
    ((= ty "TEXT") (setq ln (strcat ln (ehr:pt (cdr (assoc 10 d))) ";" (ehr:pt (cdr (assoc 11 d)))
                    ";H=" (rtos (cdr (assoc 40 d)) 2 3) ";J=" (itoa (cdr (assoc 72 d))) "/" (itoa (cdr (assoc 73 d)))
                    ";ROT=" (rtos (cdr (assoc 50 d)) 2 4) ";ST=" (cdr (assoc 7 d)) ";T=" (ehr:clean (cdr (assoc 1 d))))))
    ((= ty "MTEXT") (setq ln (strcat ln (ehr:pt (cdr (assoc 10 d))) ";H=" (rtos (cdr (assoc 40 d)) 2 3)
                    ";W=" (rtos (cdr (assoc 41 d)) 2 3) ";AP=" (itoa (cdr (assoc 71 d))) ";ST=" (cdr (assoc 7 d))
                    ";T=" (ehr:clean (vla-get-textstring o)))))
    ((= ty "LWPOLYLINE")
      (setq ln (strcat ln "C=" (itoa (logand 1 (cdr (assoc 70 d)))) ";W=" (rtos (vla-get-constantwidth o) 2 3) ";V="))
      (foreach v d (if (= (car v) 10) (setq ln (strcat ln (ehr:pt (cdr v)) " ")))))
    ((= ty "INSERT") (setq ln (strcat ln "B=" (cdr (assoc 2 d)) ";P=" (ehr:pt (cdr (assoc 10 d)))
                    ";S=" (rtos (cdr (assoc 41 d)) 2 3) "," (rtos (cdr (assoc 42 d)) 2 3) ";ROT=" (rtos (cdr (assoc 50 d)) 2 4)))))
  (write-line ln f))
(defun c:EHRDUMP (/ fn f ss i e blks b be lay)
  (setq fn (strcat (getvar "DWGPREFIX") "EHR_DUMP.txt"))
  (setq f (open fn "w" "utf8"))
  (write-line (strcat "#INSUNITS=" (itoa (getvar "INSUNITS")) " LTSCALE=" (rtos (getvar "LTSCALE") 2 3)
                      " EXTMIN=" (ehr:pt (getvar "EXTMIN")) " EXTMAX=" (ehr:pt (getvar "EXTMAX"))
                      " TEXTSTYLE=" (getvar "TEXTSTYLE") " CLAYER=" (getvar "CLAYER")) f)
  (setq lay (tblnext "LAYER" T))
  (while lay
    (write-line (strcat "#LAYER\t" (cdr (assoc 2 lay)) "\t" (itoa (cdr (assoc 62 lay))) "\t" (cdr (assoc 6 lay))) f)
    (setq lay (tblnext "LAYER")))
  (setq lay (tblnext "STYLE" T))
  (while lay
    (write-line (strcat "#STYLE\t" (cdr (assoc 2 lay)) "\t" (cdr (assoc 3 lay)) "\t" (rtos (cdr (assoc 40 lay)) 2 3) "\t" (rtos (cdr (assoc 41 lay)) 2 3)) f)
    (setq lay (tblnext "STYLE")))
  (setq ss (ssget "_X" (list (cons 410 "Model"))) i 0 blks '())
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) i (1+ i))
      (ehr:ent f e "")
      (if (= (cdr (assoc 0 (entget e))) "INSERT")
        (progn (setq b (cdr (assoc 2 (entget e))))
               (if (not (member b blks)) (setq blks (cons b blks)))))))
  (foreach b blks
    (write-line (strcat "#BLOCK\t" b) f)
    (setq be (cdr (assoc -2 (tblsearch "BLOCK" b))))
    (while be (ehr:ent f be "  ") (setq be (entnext be))))
  (close f)
  (princ (strcat "\nEHR_DUMP OK: " (itoa (if ss (sslength ss) 0)) " entidades -> " fn))
  (princ))
(princ "\nDigite EHRDUMP")
(princ)
